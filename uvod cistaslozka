    <style>
        :root {
            --neon-blue: #00f0ff;
            --dark-bg: #030303;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: #ffffff;
            overflow-x: hidden;
        }
        
        /* Background Glow Orbs */
        .glow-orb {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(0,240,255,0.15) 0%, rgba(0,0,0,0) 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: -1;
            filter: blur(40px);
        }

        /* Custom Gradients & Text */
        .text-gradient {
            background: linear-gradient(90deg, #ffffff 0%, var(--neon-blue) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* XimoX Logo Styling */
        .logo-ximox {
            font-weight: 800;
            letter-spacing: -0.05em;
            display: inline-flex;
            align-items: center;
        }
        .logo-x {
            color: var(--neon-blue);
            text-shadow: 0 0 12px rgba(0, 240, 255, 0.7);
        }
        .logo-imomiddle {
            color: #ffffff;
        }
        .logo-lightning {
            display: inline-block;
            margin-left: -3px;
            margin-right: -3px;
            vertical-align: middle;
            color: var(--neon-blue);
            filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.9));
        }

        /* Card Hover Effects */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .glass-card:hover {
            border-color: rgba(0, 240, 255, 0.5);
            transform: translateY(-5px);
            box-shadow: 0 10px 40px -10px rgba(0, 240, 255, 0.2);
            background: rgba(0, 240, 255, 0.03);
        }

        /* Button Styling */
        .btn-glow {
            position: relative;
            background: transparent;
            color: var(--neon-blue);
            border: 1px solid var(--neon-blue);
            transition: 0.3s;
            overflow: hidden;
            z-index: 1;
        }
        .btn-glow::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: var(--neon-blue);
            z-index: -1;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }
        .btn-glow:hover {
            color: #000;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.6);
        }
        .btn-glow:hover::before {
            transform: scaleX(1);
        }

        /* Scroll Reveal Animations */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s ease-out;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Infinite Marquee Animation */
        .marquee-container {
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            background: rgba(255, 255, 255, 0.01);
            border-top: 1px solid rgba(255,255,255,0.05);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding: 1.5rem 0;
        }
        .marquee-content {
            display: inline-block;
            animation: scroll 30s linear infinite;
        }
        .marquee-content span {
            display: inline-block;
            margin: 0 2rem;
            font-size: 1.25rem;
            font-weight: 800;
            color: transparent;
            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: 0.3s;
        }
        .marquee-content span:hover {
            -webkit-text-stroke: 1px var(--neon-blue);
            color: var(--neon-blue);
            text-shadow: 0 0 15px rgba(0,240,255,0.5);
        }
        @keyframes scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--dark-bg); }
        ::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.3); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--neon-blue); }

        /* Portfolio Mockup UI Element */
        .mockup-ui {
            background: linear-gradient(145deg, #111, #050505);
            border: 1px solid rgba(255,255,255,0.1);
            border-top: 1px solid rgba(0,240,255,0.3);
            box-shadow: 0 20px 50px -10px rgba(0,0,0,0.8);
        }

        /* Trik pro zmenšení celého webu do malého boxu (Mini-Web) */
        .mini-web-viewport {
            width: 100%;
            height: 380px;
            overflow: hidden;
            position: relative;
            background: #0a0a0c;
            border-radius: 0.75rem;
        }
        .mini-web-iframe {
            width: 250%; /* Vykreslí se jako široká desktopová obrazovka */
            height: 265%; /* Mírně vyšší, aby se spodní lišta Netlify schovala pod ořez */
            transform: scale(0.4); /* Zmenší celý web na 40 %, takže je vidět kompletně celý */
            transform-origin: 0 0;
            border: 0;
            position: absolute;
            top: 0;
            left: 0;
        }
    </style>
</head>
