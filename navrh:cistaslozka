            const mockAres = {
                '08912345': { name: 'Čistá Složka Digital s.r.o.', dic: 'CZ08912345', addr: 'Masarykova 412/18, 602 00 Brno' },
                '27082440': { name: 'Alza.cz a.s.', dic: 'CZ27082440', addr: 'Jankovcova 1522/53, 170 00 Praha 7' },
                '26168685': { name: 'Seznam.cz, a.s.', dic: 'CZ26168685', addr: 'Radlická 3294/10, 150 00 Praha 5' },
                '45274649': { name: 'ČEZ, a. s.', dic: 'CZ45274649', addr: 'Duhová 2/1444, 140 53 Praha 4' }
            };

            if (side === 'my') {
                const ico = document.getElementById('my-ico').value.trim();
                const d = mockAres[ico] || { name: 'Moje Společnost s.r.o. (ARES)', dic: 'CZ' + ico, addr: 'Václavské náměstí 1, 110 00 Praha 1' };
                document.getElementById('my-name').value = d.name;
                document.getElementById('my-dic').value = d.dic;
                document.getElementById('my-address').value = d.addr;
            } else {
                const ico = document.getElementById('client-ico').value.trim();
                const d = mockAres[ico] || { name: 'Obchodní Partner s.r.o. (ARES)', dic: 'CZ' + ico, addr: 'Sokolovská 100/94, 186 00 Praha 8' };
                document.getElementById('client-name').value = d.name;
                document.getElementById('client-dic').value = d.dic;
                document.getElementById('client-address').value = d.addr;
            }
            renderA4();
        }

        // 6. Výpočet splatnosti (+7, +14, +30 dní nebo vlastní)
        function initDates() {
            const now = new Date();
            document.getElementById('date-issue').value = toIsoDate(now);
            setDueDays(14);
        }

        function setDueDays(days) {
            dueDaysMode = days;
            ['7', '14', '30', 'custom'].forEach(k => {
                document.getElementById('due-' + k).classList.toggle('active', String(days) === k);
            });
            if (days === 'custom') {
                document.getElementById('date-due').focus();
            } else {
                recalcDueDate();
            }
        }

        function markCustomDue() {
            dueDaysMode = 'custom';
            ['7', '14', '30', 'custom'].forEach(k => {
                document.getElementById('due-' + k).classList.toggle('active', k === 'custom');
            });
        }

        function recalcDueDate() {
            if (dueDaysMode === 'custom') {
                renderA4();
                return;
            }
            const issueStr = document.getElementById('date-issue').value;
            if (!issueStr) return;
            const d = new Date(issueStr);
            d.setDate(d.getDate() + Number(dueDaysMode));
            document.getElementById('date-due').value = toIsoDate(d);
            renderA4();
        }

        function toIsoDate(d) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        function toCzDate(iso) {
            if (!iso) return '';
            const p = iso.split('-');
            return p.length === 3 ? `${p[2]}. ${p[1]}. ${p[0]}` : iso;
        }

        // 7. Přepínání 3 šablon A4
        function setTemplate(tpl) {
            const paper = document.getElementById('a4-paper');
            paper.classList.remove('tpl-minimal', 'tpl-corporate', 'tpl-creative');
            paper.classList.add('tpl-' + tpl);

            document.getElementById('tpl-btn-minimal').classList.toggle('active', tpl === 'minimal');
            document.getElementById('tpl-btn-corporate').classList.toggle('active', tpl === 'corporate');
            document.getElementById('tpl-btn-creative').classList.toggle('active', tpl === 'creative');
        }

        // 8. Vykreslení A4 dokumentu podle zvoleného schématu
        function renderA4() {
            const schema = DOC_SCHEMAS[currentDocKey];
            const docNum = document.getElementById('doc-number').value;
            const issueCz = toCzDate(document.getElementById('date-issue').value);
            const dueCz = toCzDate(document.getElementById('date-due').value);
            const subject = document.getElementById('doc-subject').value;
            const extraDetail = document.getElementById('doc-extra-detail').value;
            const rawAmount = Number(document.getElementById('doc-amount').value || 0);
            const vatVal = document.getElementById('doc-vat').value;

            document.getElementById('a4-ev').textContent = docNum;
            document.getElementById('a4-role-1').textContent = schema.role1;
            document.getElementById('a4-role-2').textContent = schema.role2;

            document.getElementById('a4-my-name').textContent = document.getElementById('my-name').value;
            document.getElementById('a4-my-address').textContent = document.getElementById('my-address').value;
            document.getElementById('a4-my-ico').textContent = document.getElementById('my-ico').value;
            document.getElementById('a4-my-dic').textContent = document.getElementById('my-dic').value;
            document.getElementById('a4-my-bank').textContent = document.getElementById('my-bank').value;

            document.getElementById('a4-client-name').textContent = document.getElementById('client-name').value;
            document.getElementById('a4-client-address').textContent = document.getElementById('client-address').value;
            document.getElementById('a4-client-meta-line').innerHTML = `<strong>IČO / ID:</strong> ${document.getElementById('client-ico').value} | <strong>DIČ / Údaj:</strong> ${document.getElementById('client-dic').value}`;

