<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cistaslozka.cz | Fakturační a právní systém</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        /* ==========================================================================
           1. BAREVNÝ SYSTÉM PODLE LOGA CISTASLOZKA.CZ (BEZ EMOJI, ČISTÁ SYMETRIE)
           ========================================================================== */
        :root {
            --navy-primary: #173753;
            --navy-dark: #0F263A;
            --navy-Tint: #F0F5F9;

            --green-primary: #159A62;
            --green-hover: #107C4E;
            --green-tint: #EAF6F0;

            --bg-body: #F4F7FA;
            --bg-surface: #FFFFFF;
            --bg-muted: #F8FAFC;

            --text-dark: #0F172A;
            --text-medium: #334155;
            --text-light: #64748B;

            --border-std: #CBD5E1;
            --border-subtle: #E2E8F0;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;

            --shadow-card: 0 2px 6px rgba(23, 55, 83, 0.05), 0 1px 2px rgba(23, 55, 83, 0.04);
            --shadow-dropdown: 0 12px 28px rgba(15, 38, 58, 0.16);
            --shadow-a4: 0 14px 40px rgba(15, 38, 58, 0.12);

            --base-font: 16px;
        }

        body.large-text {
            --base-font: 18px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            font-size: var(--base-font);
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            line-height: 1.55;
            overflow-x: hidden;
            font-variant-numeric: tabular-nums;
        }

        h1, h2, h3, h4 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--navy-primary);
            letter-spacing: -0.02em;
        }

        /* ==========================================================================
           2. HORNÍ HLAVNÍ LIŠTA A ROZBALOVACÍ KATEGORIE (SMĚREM DOLŮ)
           ========================================================================== */
        .top-header {
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-std);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow-card);
        }

        .top-header-upper {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0.85rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
        }

        .brand-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--navy-primary);
            letter-spacing: -0.03em;
        }

        .brand-title span {
            color: var(--green-primary);
        }

        .top-controls {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        /* Přepínač tarifu OSVČ / s.r.o. */
        .tariff-pill-switch {
            display: inline-flex;
            background: var(--navy-Tint);
            padding: 0.25rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-std);
        }

        .tariff-pill-btn {
            border: none;
            background: transparent;
            padding: 0.45rem 0.9rem;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-medium);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
        }

        .tariff-pill-btn.active {
            background: var(--navy-primary);
            color: #FFFFFF;
        }

        .btn-top-nav {
            padding: 0.55rem 1rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-std);
            background: var(--bg-surface);
            color: var(--navy-primary);
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-top-nav:hover {
            background: var(--navy-Tint);
        }

        .btn-top-nav.active {
            background: var(--green-primary);
            color: #FFFFFF;
            border-color: var(--green-primary);
        }

        /* Druhá řada horní lišty: Rozbalovací kategorie dokumentů */
        .category-navbar {
            background: var(--navy-primary);
            border-top: 1px solid var(--navy-dark);
        }

        .category-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            flex-wrap: wrap;
        }

        .cat-dropdown {
            position: relative;
        }

        .cat-trigger {
            background: transparent;
            color: #FFFFFF;
            border: none;
            padding: 0.9rem 1.15rem;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 3px solid transparent;
            transition: all 0.15s;
        }

        .cat-trigger:hover,
        .cat-dropdown.open .cat-trigger {
            background: rgba(255, 255, 255, 0.08);
            border-bottom-color: var(--green-primary);
        }

        .chevron-down {
            width: 0;
            height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-top: 5px solid #FFFFFF;
            opacity: 0.8;
        }

        .cat-menu {
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 290px;
            background: var(--bg-surface);
            border: 1px solid var(--border-std);
            border-radius: 0 0 var(--radius-md) var(--radius-md);
            box-shadow: var(--shadow-dropdown);
            padding: 0.5rem;
            display: none;
            z-index: 2000;
        }

        .cat-dropdown.open .cat-menu {
            display: block;
        }

        .cat-menu-item {
            display: block;
            width: 100%;
            text-align: left;
            padding: 0.7rem 0.95rem;
            border: none;
            background: transparent;
            color: var(--text-dark);
            font-size: 0.92rem;
            font-weight: 500;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.12s;
        }

        .cat-menu-item:hover {
            background: var(--green-tint);
            color: var(--green-hover);
            font-weight: 600;
        }

        .cat-menu-item.active {
            background: var(--navy-primary);
            color: #FFFFFF;
            font-weight: 600;
        }

        .sro-badge {
            background: var(--green-primary);
            color: #FFFFFF;
            font-size: 0.7rem;
            padding: 0.1rem 0.4rem;
            border-radius: 3px;
            margin-left: 0.35rem;
            text-transform: uppercase;
            font-weight: 700;
        }

        /* ==========================================================================
           3. HLAVNÍ KONTEJNER (ŽÁDNÉ SCROLLOVÁNÍ DO STRANY, VŠE POD SEBOU)
           ========================================================================== */
        .main-container {
            max-width: 1120px;
            margin: 2rem auto 4rem auto;
            padding: 0 1.5rem;
        }

        /* ==========================================================================
           4. OBRAZOVKA: ONBOARDING (VÝBĚR OSVČ / FIRMA S.R.O.)
           ========================================================================== */
        .onboarding-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .onboarding-card {
            background: var(--bg-surface);
            border: 2px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 2.25rem;
            box-shadow: var(--shadow-card);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.2s;
        }

        .onboarding-card:hover {
            border-color: var(--green-primary);
        }

        .onboarding-tag {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.35rem 0.75rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1rem;
        }

        .tag-green {
            background: var(--green-tint);
            color: var(--green-primary);
        }

        .tag-navy {
            background: var(--navy-Tint);
            color: var(--navy-primary);
        }

        .clean-list {
            list-style: none;
            margin: 1.5rem 0 2rem 0;
            border-top: 1px solid var(--border-subtle);
            padding-top: 1.25rem;
        }

        .clean-list li {
            padding: 0.5rem 0;
            font-size: 0.95rem;
            color: var(--text-medium);
            display: flex;
            align-items: baseline;
            gap: 0.65rem;
        }

        .clean-list li::before {
            content: "";
            width: 7px;
            height: 7px;
            background: var(--green-primary);
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ==========================================================================
           5. OBRAZOVKA: ARCHIV A PŘEHLED VYSTAVENÝCH DOKLADŮ (UPRAVIT / TISK)
           ========================================================================== */
        .archive-box {
            background: var(--bg-surface);
            border: 1px solid var(--border-std);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            box-shadow: var(--shadow-card);
        }

        .archive-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-subtle);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .archive-table {
            width: 100%;
            border-collapse: collapse;
        }

        .archive-table th {
            text-align: left;
            padding: 0.85rem 1rem;
            background: var(--navy-Tint);
            color: var(--navy-primary);
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
            border-bottom: 2px solid var(--border-std);
        }

        .archive-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-subtle);
            font-size: 0.95rem;
            vertical-align: middle;
        }

        .archive-table tr:hover td {
            background: var(--bg-muted);
        }

        .status-pill {
            display: inline-block;
            padding: 0.25rem 0.65rem;
            border-radius: 4px;
            font-size: 0.78rem;
            font-weight: 700;
            background: var(--green-tint);
            color: var(--green-primary);
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

        .btn-sm {
            padding: 0.45rem 0.85rem;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: var(--radius-sm);
            cursor: pointer;
            border: 1px solid var(--border-std);
            background: var(--bg-surface);
            color: var(--navy-primary);
            transition: all 0.15s;
        }

        .btn-sm:hover {
            background: var(--navy-primary);
            color: #FFFFFF;
            border-color: var(--navy-primary);
        }

        .btn-sm.green {
            background: var(--green-primary);
            color: #FFFFFF;
            border-color: var(--green-primary);
        }

        .btn-sm.green:hover {
            background: var(--green-hover);
        }

        /* ==========================================================================
           6. SYMETRICKÝ FORMULÁŘ PRO VYPLŇOVÁNÍ DOKUMENTU (NAHOŘE NAD A4)
           ========================================================================== */
        .builder-top-bar {
            background: var(--bg-surface);
            border: 1px solid var(--border-std);
            border-radius: var(--radius-md);
            padding: 1.35rem 1.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            box-shadow: var(--shadow-card);
        }

        .doc-breadcrumb {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--green-primary);
            margin-bottom: 0.2rem;
        }

        .builder-top-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .btn-primary-green {
            background: var(--green-primary);
            color: #FFFFFF;
            border: none;
            padding: 0.8rem 1.4rem;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background 0.15s;
        }

        .btn-primary-green:hover {
            background: var(--green-hover);
        }

        .btn-secondary-navy {
            background: var(--navy-primary);
            color: #FFFFFF;
            border: none;
            padding: 0.8rem 1.3rem;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background 0.15s;
        }

        .btn-secondary-navy:hover {
            background: var(--navy-dark);
        }

        /* Symetrická mřížka pro Stranu 1 a Stranu 2 */
        .parties-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .form-section-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-std);
            border-radius: var(--radius-md);
            padding: 1.6rem;
            box-shadow: var(--shadow-card);
        }

        .card-header-line {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.85rem;
            margin-bottom: 1.25rem;
            border-bottom: 2px solid var(--navy-Tint);
        }

        .card-step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--navy-primary);
            color: #FFFFFF;
            font-size: 0.82rem;
            font-weight: 700;
            margin-right: 0.5rem;
        }

        .card-header-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--navy-primary);
            display: flex;
            align-items: center;
        }

        .ares-tag {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--green-primary);
            background: var(--green-tint);
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
        }

        /* Perfektně zarovnaná mřížka polí uvnitř karet */
        .sym-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .sym-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .sym-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .field-box {
            display: flex;
            flex-direction: column;
        }

        .field-box.full-span {
            grid-column: 1 / -1;
        }

        .field-label {
            font-size: 0.84rem;
            font-weight: 700;
            color: var(--text-medium);
            margin-bottom: 0.4rem;
        }

        .field-input,
        .field-select,
        .field-textarea {
            width: 100%;
            padding: 0.68rem 0.85rem;
            font-size: 0.95rem;
            font-family: inherit;
            color: var(--text-dark);
            background: var(--bg-muted);
            border: 1px solid var(--border-std);
            border-radius: var(--radius-sm);
            transition: all 0.15s;
        }

        .field-input:focus,
        .field-select:focus,
        .field-textarea:focus {
            outline: none;
            background: var(--bg-surface);
            border-color: var(--green-primary);
            box-shadow: 0 0 0 3px rgba(21, 154, 98, 0.14);
        }

        .ares-input-group {
            display: flex;
            gap: 0.5rem;
        }

        .btn-ares {
            background: var(--navy-primary);
            color: #FFFFFF;
            border: none;
            padding: 0 1rem;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s;
        }

        .btn-ares:hover {
            background: var(--green-primary);
        }

        /* Rychlá tlačítka splatnosti (+7, +14, +30, Vlastní) */
        .due-btn-group {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.35rem;
        }

        .due-btn {
            padding: 0.65rem 0.4rem;
            border: 1px solid var(--border-std);
            background: var(--bg-muted);
            color: var(--text-dark);
            font-weight: 700;
            font-size: 0.84rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s;
        }

        .due-btn.active {
            background: var(--green-primary);
            color: #FFFFFF;
            border-color: var(--green-primary);
        }

        /* ==========================================================================
           7. PŘEPÍNAČ 3 ŠABLON A PLNÁ ŠÍŘKA PAPÍRU A4 DOLE POD FORMULÁŘEM
           ========================================================================== */
        .template-bar {
            max-width: 860px;
            margin: 2rem auto 1rem auto;
            background: var(--navy-primary);
            color: #FFFFFF;
            padding: 0.9rem 1.5rem;
            border-radius: var(--radius-md);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .template-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .tpl-option-btn {
            background: rgba(255, 255, 255, 0.12);
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 0.5rem 1rem;
            border-radius: var(--radius-sm);
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s;
        }

        .tpl-option-btn.active {
            background: var(--green-primary);
            border-color: var(--green-primary);
        }

        /* Plátno pro list A4 */
        .a4-wrapper {
            display: flex;
            justify-content: center;
        }

        .a4-document {
            width: 100%;
            max-width: 860px;
            min-height: 1120px;
            background: #FFFFFF;
            border: 1px solid var(--border-std);
            box-shadow: var(--shadow-a4);
            padding: 3.5rem 4rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* --- ŠABLONA 1: MINIMALISTICKÁ --- */
        .a4-document.tpl-minimal {
            font-family: 'Inter', sans-serif;
            border-top: 8px solid var(--green-primary);
        }
        .tpl-minimal .doc-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--border-subtle);
        }
        .tpl-minimal .doc-title {
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--navy-primary);
        }
        .tpl-minimal .doc-parties-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        .tpl-minimal .doc-party-card {
            background: var(--bg-muted);
            border: 1px solid var(--border-subtle);
            padding: 1.25rem;
            border-radius: var(--radius-sm);
        }

        /* --- ŠABLONA 2: KORPORÁTNÍ (Tradiční úřední) --- */
        .a4-document.tpl-corporate {
            font-family: 'Lora', Georgia, serif;
            color: #000000;
        }
        .tpl-corporate .doc-head {
            border: 2px solid #000000;
            padding: 1.25rem;
            margin-bottom: 1.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #F8FAFC;
        }
        .tpl-corporate .doc-title {
            font-size: 1.65rem;
            font-weight: 700;
            color: #000000;
            text-transform: uppercase;
        }
        .tpl-corporate .doc-parties-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border: 2px solid #000000;
            margin-bottom: 2rem;
        }
        .tpl-corporate .doc-party-card {
            padding: 1.25rem;
        }
        .tpl-corporate .doc-party-card:first-child {
            border-right: 2px solid #000000;
        }

        /* --- ŠABLONA 3: KREATIVNÍ (Firemní barvy čistásložka.cz) --- */
        .a4-document.tpl-creative {
            font-family: 'Plus Jakarta Sans', sans-serif;
            padding-top: 0;
        }
        .tpl-creative .doc-head {
            background: linear-gradient(135deg, var(--navy-primary) 0%, var(--green-primary) 100%);
            color: #FFFFFF;
            margin: 0 -4rem 2.25rem -4rem;
            padding: 2.5rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .tpl-creative .doc-title {
            color: #FFFFFF;
            font-size: 2rem;
            font-weight: 800;
        }
        .tpl-creative .doc-parties-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .tpl-creative .doc-party-card {
            background: var(--navy-Tint);
            border-left: 5px solid var(--green-primary);
            padding: 1.25rem;
            border-radius: 0 8px 8px 0;
        }

        .party-caption {
            font-size: 0.76rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--green-primary);
            margin-bottom: 0.45rem;
        }
        .tpl-corporate .party-caption {
            color: #000000;
            text-decoration: underline;
        }

        .doc-meta-strip {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            background: var(--bg-muted);
            border: 1px solid var(--border-std);
            border-radius: var(--radius-sm);
            padding: 0.85rem 1.25rem;
            margin-bottom: 2rem;
            font-size: 0.9rem;
        }

        .doc-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }
        .doc-table th {
            background: var(--navy-primary);
            color: #FFFFFF;
            text-align: left;
            padding: 0.75rem 1rem;
            font-size: 0.82rem;
            text-transform: uppercase;
        }
        .tpl-corporate .doc-table th {
            background: #E2E8F0;
            color: #000000;
            border: 1px solid #000000;
        }
        .doc-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-std);
        }
        .tpl-corporate .doc-table td {
            border: 1px solid #000000;
        }

        .doc-bottom-summary {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding-top: 1.5rem;
            margin-top: 1.5rem;
            border-top: 2px solid var(--navy-primary);
        }

        .qr-box {
            border: 2px solid var(--navy-primary);
            padding: 0.5rem;
            border-radius: 6px;
            width: 115px;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 700;
        }

        .price-highlight-box {
            background: var(--green-tint);
            border: 2px solid var(--green-primary);
            padding: 1rem 1.65rem;
            border-radius: var(--radius-sm);
            text-align: right;
        }

        .doc-signatures-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3.5rem;
            padding-top: 1rem;
        }

        .signature-script {
            font-family: 'Lora', Georgia, serif;
            font-style: italic;
            font-size: 1.3rem;
            color: var(--navy-primary);
            text-align: center;
            min-height: 32px;
            margin-bottom: 0.35rem;
        }

        .signature-line {
            border-top: 1.5px solid var(--text-dark);
            padding-top: 0.45rem;
            text-align: center;
            font-size: 0.86rem;
            color: var(--text-medium);
        }

        .hidden {
            display: none !important;
        }

        /* ==========================================================================
           8. ČISTÝ TISK A STÁHNUTÍ DO PDF (VYTISKNE SE POUZE DOKUMENT A4)
           ========================================================================== */
        @media print {
            @page {
                size: A4 portrait;
                margin: 12mm;
            }
            body {
                background: #FFFFFF !important;
            }
            .top-header,
            #view-onboarding,
            #view-archive,
            .builder-top-bar,
            .parties-form-grid,
            #specific-form-card,
            .template-bar {
                display: none !important;
            }
            .main-container,
            #view-builder,
            .a4-wrapper {
                display: block !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .a4-document {
                box-shadow: none !important;
                border: none !important;
                max-width: 100% !important;
                width: 100% !important;
                min-height: auto !important;
                padding: 0 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

        @media (max-width: 900px) {
            .onboarding-grid,
            .parties-form-grid,
            .sym-grid-2,
            .sym-grid-3,
            .sym-grid-4 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
