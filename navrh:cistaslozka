            const boxSubject = document.getElementById('box-subject');
            const boxExtra = document.getElementById('box-extra-detail');
            const boxAmount = document.getElementById('box-amount');
            const boxVat = document.getElementById('box-vat');

            // Zobrazení / skrytí polí přesně podle logiky dokumentu
            if (schema.mode === 'invoice_no_vat') {
                boxSubject.style.gridColumn = 'span 2';
                boxExtra.classList.add('hidden');
                boxAmount.classList.remove('hidden');
                boxVat.classList.add('hidden');
                document.getElementById('label-amount').textContent = schema.amountLabel;
                document.getElementById('my-dic').value = 'Neplátce DPH';
            } else if (schema.mode === 'invoice_vat') {
                boxSubject.style.gridColumn = 'span 1';
                boxExtra.classList.add('hidden');
                boxAmount.classList.remove('hidden');
                boxVat.classList.remove('hidden');
                document.getElementById('label-amount').textContent = schema.amountLabel;
                document.getElementById('my-dic').value = 'CZ08912345 (Plátce DPH)';
            } else if (schema.mode === 'contract_paid') {
                boxSubject.style.gridColumn = 'span 2';
                boxExtra.classList.add('hidden');
                boxAmount.classList.remove('hidden');
                boxVat.classList.add('hidden');
                document.getElementById('label-amount').textContent = schema.amountLabel;
            } else if (schema.mode === 'hr_paid') {
                boxSubject.style.gridColumn = 'span 1';
                boxExtra.classList.remove('hidden');
                boxAmount.classList.remove('hidden');
                boxVat.classList.add('hidden');
                document.getElementById('label-extra-detail').textContent = schema.extraLabel;
                document.getElementById('label-amount').textContent = schema.amountLabel;
            } else if (schema.mode === 'no_price') {
                // Dokumenty bez ceny (Rozvázání poměru, Výpověď, Vytýkací dopis, NDA, Plná moc, BOZP...)
                boxSubject.style.gridColumn = 'span 2';
                boxExtra.classList.remove('hidden');
                boxAmount.classList.add('hidden');
                boxVat.classList.add('hidden');
                document.getElementById('label-extra-detail').textContent = schema.extraLabel;
            }

            renderA4();
        }

        // 5. Načtení z ARESu (Moje firma + Druhá strana)
