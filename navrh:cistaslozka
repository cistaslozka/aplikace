            document.getElementById('a4-label-date-2').textContent = schema.date2Label + ':';
            document.getElementById('a4-date-due').textContent = dueCz;
            document.getElementById('a4-payment').textContent = document.getElementById('doc-payment').value;
            document.getElementById('a4-signature-val').textContent = document.getElementById('doc-signature').value;

            const bodyEl = document.getElementById('a4-body-content');
            const finFooter = document.getElementById('a4-financial-footer');
            const qrBox = document.getElementById('a4-qr-box');

            const fmtBase = rawAmount.toLocaleString('cs-CZ') + ' Kč';

            if (schema.mode === 'invoice_no_vat') {
                document.getElementById('a4-title').textContent = schema.title.split('(')[0].toUpperCase() + ' č. ' + docNum;
                document.getElementById('a4-subtitle').textContent = 'Doklad vystavený neplátcem DPH';
                finFooter.classList.remove('hidden');
                qrBox.classList.remove('hidden');

                bodyEl.innerHTML = `
                    <table class="doc-table">
                        <thead>
                            <tr>
                                <th>Označení dodávky / fakturované položky</th>
                                <th>Množství</th>
                                <th style="text-align: right;">Celková částka</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>${subject}</strong></td>
                                <td>1 komplet</td>
                                <td style="text-align: right; font-weight: 700;">${fmtBase}</td>
                            </tr>
                        </tbody>
                    </table>
                `;
                document.getElementById('a4-total-caption').textContent = 'CELKEM K ÚHRADĚ';
                document.getElementById('a4-total-amount').textContent = fmtBase;
                document.getElementById('a4-total-subnote').textContent = 'Neplátce DPH – částka je konečná';

            } else if (schema.mode === 'invoice_vat') {
                const rate = vatVal === '21' ? 0.21 : (vatVal === '12' ? 0.12 : 0);
                const vatMoney = Math.round(rawAmount * rate);
                const totalMoney = rawAmount + vatMoney;

                document.getElementById('a4-title').textContent = schema.title.split('(')[0].toUpperCase() + ' č. ' + docNum;
                document.getElementById('a4-subtitle').textContent = 'Daňový doklad (Plátce DPH)';
                finFooter.classList.remove('hidden');
                qrBox.classList.remove('hidden');

                bodyEl.innerHTML = `
                    <table class="doc-table">
                        <thead>
                            <tr>
                                <th>Označení zdanitelného plnění</th>
                                <th>Základ daně</th>
                                <th>DPH (${vatVal === 'reverse' ? 'Přenesená 0 %' : vatVal + ' %'})</th>
                                <th style="text-align: right;">Celkem s DPH</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>${subject}</strong></td>
                                <td>${fmtBase}</td>
                                <td>${vatMoney.toLocaleString('cs-CZ')} Kč</td>
                                <td style="text-align: right; font-weight: 700;">${totalMoney.toLocaleString('cs-CZ')} Kč</td>
                            </tr>
                        </tbody>
                    </table>
                `;
                document.getElementById('a4-total-caption').textContent = 'CELKEM K ÚHRADĚ S DPH';
                document.getElementById('a4-total-amount').textContent = totalMoney.toLocaleString('cs-CZ') + ' Kč';
                document.getElementById('a4-total-subnote').textContent = `Základ: ${fmtBase} + DPH: ${vatMoney.toLocaleString('cs-CZ')} Kč`;

            } else if (schema.mode === 'contract_paid') {
                document.getElementById('a4-title').textContent = schema.title.split('(')[0].toUpperCase();
                document.getElementById('a4-subtitle').textContent = 'Obchodní smluvní dokument č. ' + docNum;
                finFooter.classList.remove('hidden');
                qrBox.classList.add('hidden');

                bodyEl.innerHTML = `
                    <div style="line-height: 1.75; font-size: 0.96rem;">
                        <p style="margin-bottom: 1rem;"><strong>Článek I. Předmět smlouvy</strong><br>
                        ${schema.role1} (<strong>${document.getElementById('my-name').value}</strong>) se touto smlouvou zavazuje pro druhou smluvní stranu (${schema.role2}: <strong>${document.getElementById('client-name').value}</strong>) řádně realizovat následující předmět plnění: <strong>${subject}</strong>.</p>
                        <p style="margin-bottom: 1rem;"><strong>Článek II. Cena a platební podmínky</strong><br>
                        Smluvní strany sjednávají za výše uvedené plnění odměnu ve výši <strong>${fmtBase}</strong>. Termín plnění / splatnosti je sjednán do <strong>${dueCz}</strong>.</p>
                        <p><strong>Článek III. Závěrečná ustanovení</strong><br>
                        Tato smlouva nabývá platnosti a účinnosti dnem podpisu oběma smluvními stranami a řídí se zákonem č. 89/2012 Sb., občanský zákoník.</p>
                    </div>
                `;
                document.getElementById('a4-total-caption').textContent = 'SJEDNANÁ SMLUVNÍ ODMĚNA';
                document.getElementById('a4-total-amount').textContent = fmtBase;
                document.getElementById('a4-total-subnote').textContent = 'Dle podmínek této smlouvy';

            } else if (schema.mode === 'hr_paid') {
                document.getElementById('a4-title').textContent = schema.title.split('–')[0].toUpperCase();
                document.getElementById('a4-subtitle').textContent = 'Pracovněprávní dokument dle zákona č. 262/2006 Sb., zákoník práce';
                finFooter.classList.remove('hidden');
                qrBox.classList.add('hidden');

                bodyEl.innerHTML = `
                    <div style="line-height: 1.75; font-size: 0.96rem;">
                        <p style="margin-bottom: 1rem;"><strong>Článek I. Druh a místo výkonu práce</strong><br>
                        Zaměstnanec (<strong>${document.getElementById('client-name').value}</strong>) bude u Zaměstnavatele (<strong>${document.getElementById('my-name').value}</strong>) vykonávat práci na pozici: <strong>${subject}</strong>.<br>
                        Doplňující určení a místo výkonu práce: <strong>${extraDetail}</strong>.</p>
                        <p style="margin-bottom: 1rem;"><strong>Článek II. Den nástupu a mzdové podmínky</strong><br>
                        Den nástupu do práce / účinnosti se sjednává na <strong>${dueCz}</strong>. Za vykonanou práci přísluší zaměstnanci hrubá mzda / odměna ve výši <strong>${fmtBase}</strong>.</p>
                        <p><strong>Článek III. Práva a povinnosti</strong><br>
                        Ostatní práva a povinnosti zaměstnavatele a zaměstnance se řídí zákoníkem práce České republiky a vnitřními předpisy zaměstnavatele.</p>
                    </div>
                `;
                document.getElementById('a4-total-caption').textContent = 'SJEDNANÁ HRUBÁ MZDA / ODMĚNA';
                document.getElementById('a4-total-amount').textContent = fmtBase;
                document.getElementById('a4-total-subnote').textContent = 'Pracovněprávní agenda (HR)';

            } else if (schema.mode === 'no_price') {
                // Dokument bez jakékoliv ceny a bez DPH
                document.getElementById('a4-title').textContent = schema.title.split('–')[0].toUpperCase();
                document.getElementById('a4-subtitle').textContent = 'Oficiální právní dokument č. ' + docNum;
                finFooter.classList.add('hidden'); // Zcela skryjeme finanční patičku

                bodyEl.innerHTML = `
                    <div style="line-height: 1.8; font-size: 0.98rem;">
                        <p style="margin-bottom: 1.15rem;"><strong>Článek I. Předmět a vymezení dokumentu</strong><br>
                        <strong>${document.getElementById('my-name').value}</strong> (${schema.role1}) a <strong>${document.getElementById('client-name').value}</strong> (${schema.role2}) tímto činí následující právní jednání / záznam:<br>
                        <strong>${subject}</strong></p>
                        <p style="margin-bottom: 1.15rem;"><strong>Článek II. Specifikace a rozhodné údaje</strong><br>
