                        <p><strong>Článek III. Potvrzení a podpisy stran</strong><br>
                        Obě strany prohlašují, že obsah tohoto dokumentu odpovídá skutečnosti a jejich svobodné vůli, což stvrzují svými vlastnoručními či elektronickými podpisy níže.</p>
                    </div>
                `;
            }
        }

        // 9. Uložení aktuálně vyplněného dokumentu do Archivu a možnost jeho opětovné úpravy / tisku
        function saveCurrentToArchive() {
            const schema = DOC_SCHEMAS[currentDocKey];
            const newEntry = {
                id: Date.now(),
                docKey: currentDocKey,
                docNumber: document.getElementById('doc-number').value,
                clientName: document.getElementById('client-name').value,
                clientIco: document.getElementById('client-ico').value,
                clientDic: document.getElementById('client-dic').value,
                clientAddress: document.getElementById('client-address').value,
                dateIssue: document.getElementById('date-issue').value,
                dateDue: document.getElementById('date-due').value,
                subject: document.getElementById('doc-subject').value,
                extraDetail: document.getElementById('doc-extra-detail').value,
                amount: schema.mode === 'no_price' ? null : document.getElementById('doc-amount').value,
                vat: document.getElementById('doc-vat').value,
                status: 'Uloženo'
            };

            savedDocuments.unshift(newEntry);
            document.getElementById('archive-count').textContent = savedDocuments.length;
            switchView('archive');
        }

        function renderArchiveTable() {
            const tbody = document.getElementById('archive-tbody');
            tbody.innerHTML = savedDocuments.map(item => {
                const schema = DOC_SCHEMAS[item.docKey];
                const priceText = item.amount !== null && schema.mode !== 'no_price'
                    ? Number(item.amount).toLocaleString('cs-CZ') + ' Kč'
                    : 'Právní dokument (bez částky)';

                return `
                    <tr>
                        <td><strong>${item.docNumber}</strong></td>
                        <td>${schema.title}</td>
                        <td><strong>${item.clientName}</strong><br><span style="font-size: 0.82rem; color: var(--text-light);">${item.clientIco}</span></td>
                        <td>${toCzDate(item.dateIssue)}</td>
                        <td><strong>${priceText}</strong></td>
                        <td><span class="status-pill">${item.status}</span></td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn-sm" onclick="loadDocumentFromArchive(${item.id}, false)">Upravit</button>
                                <button type="button" class="btn-sm green" onclick="loadDocumentFromArchive(${item.id}, true)">Tisk / PDF</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function loadDocumentFromArchive(id, printImmediately) {
            const item = savedDocuments.find(d => d.id === id);
            if (!item) return;

            document.getElementById('doc-number').value = item.docNumber;
            document.getElementById('client-name').value = item.clientName;
            document.getElementById('client-ico').value = item.clientIco;
            document.getElementById('client-dic').value = item.clientDic;
            document.getElementById('client-address').value = item.clientAddress;
            document.getElementById('date-issue').value = item.dateIssue;
            document.getElementById('date-due').value = item.dateDue;
            document.getElementById('doc-subject').value = item.subject;
            document.getElementById('doc-extra-detail').value = item.extraDetail || '';
            if (item.amount !== null) {
                document.getElementById('doc-amount').value = item.amount;
            }
            document.getElementById('doc-vat').value = item.vat || '21';

            selectDoc(item.docKey);

            if (printImmediately) {
                setTimeout(() => window.print(), 200);
            }
        }

        // Inicializace
        initDates();
        selectDoc('faktura_bez_dph');
    </script>
