<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cistaslozka.cz – Fakturační a právní systém</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #0f2537;
            --primary-green: #10b981;
            --primary-green-hover: #059669;
            --bg-color: #f4f7fb;
            --card-bg: #ffffff;
            --text-color: #334155;
            --text-light: #64748b;
            --border-color: #e2e8f0;
            --shadow-sm: 0 4px 6px -1px rgba(15, 37, 55, 0.05), 0 2px 4px -1px rgba(15, 37, 55, 0.03);
            --shadow-md: 0 10px 25px -5px rgba(15, 37, 55, 0.08);
            --shadow-lg: 0 20px 40px -15px rgba(15, 37, 55, 0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 100% 0%, rgba(16, 185, 129, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 0% 100%, rgba(15, 37, 55, 0.03) 0%, transparent 50%);
            background-attachment: fixed;
        }

        h1, h2, h3, .brand-font {
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.5px;
        }

        /* ==========================================================================
           1. ZVĚTŠENÁ A VZDUŠNÁ HLAVIČKA
           ========================================================================== */
        header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .header-content {
            max-width: 1240px;
            margin: 0 auto;
            padding: 24px 32px; /* Větší odsazení pro prémiový vzhled */
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 26px; /* Větší logo */
            font-weight: 800;
            color: var(--primary-dark);
            text-decoration: none;
            letter-spacing: -0.8px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .logo-container span { color: var(--primary-green); }

        .logo-icon {
            color: var(--primary-dark);
            display: flex;
        }

        nav {
            display: flex;
            gap: 40px; /* Větší mezery mezi odkazy */
            justify-content: center;
        }

        nav a {
            text-decoration: none;
            color: var(--text-light);
            font-weight: 600;
            font-size: 16px;
            transition: all 0.2s;
            padding: 8px 12px;
            border-radius: 8px;
        }

        nav a:hover {
            color: var(--primary-dark);
            background: #f1f5f9;
        }

        .header-right {
            display: flex;
            justify-content: flex-end;
            gap: 16px;
        }

        /* ==========================================================================
           2. HLAVNÍ ROZLOŽENÍ
           ========================================================================== */
        .main-wrapper {
            max-width: 1240px;
            margin: 80px auto;
            padding: 0 32px;
            display: grid;
            grid-template-columns: 1fr 440px;
            gap: 60px;
            align-items: flex-start;
        }

        @media (max-width: 1024px) {
            .main-wrapper {
                grid-template-columns: 1fr;
                max-width: 700px;
            }
            .header-content {
                grid-template-columns: auto auto;
                justify-content: space-between;
                padding: 20px;
            }
            nav { display: none; }
        }

        /* ==========================================================================
           3. LEVÝ SLOUPEC (DETAILNÍ TARIFY)
           ========================================================================== */
        .left-column {
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .section-heading {
            font-size: 36px;
            color: var(--primary-dark);
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .section-subheading {
            font-size: 18px;
            color: var(--text-light);
            margin-bottom: 16px;
        }

        .tariff-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 36px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .tariff-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: #cbd5e1;
        }

        .tariff-pro {
            border: 2px solid var(--primary-green);
            background: linear-gradient(145deg, #ffffff, #f0fdf4);
        }

        .tariff-pro::before {
            content: "Nejoblíbenější";
            position: absolute;
            top: 16px;
            right: -32px;
            background: var(--primary-green);
            color: white;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 6px 40px;
            transform: rotate(45deg);
            letter-spacing: 1px;
        }

        .tariff-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .tariff-title {
            font-size: 24px;
            color: var(--primary-dark);
            margin-bottom: 4px;
        }

        .badge-free {
            background: #e0e7ff;
            color: #4f46e5;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .tariff-price {
            font-size: 42px;
            font-weight: 800;
            color: var(--primary-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin-bottom: 24px;
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .tariff-price span {
            font-size: 16px;
            color: var(--text-light);
            font-weight: 500;
            font-family: 'Inter', sans-serif;
        }

        .feature-list {
            list-style: none;
            margin-bottom: 32px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .feature-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 15px;
            color: var(--text-color);
        }

        .feature-icon {
            color: var(--primary-green);
            flex-shrink: 0;
            margin-top: 2px;
        }

        .promo-card {
            background: transparent;
            border: 1px dashed #cbd5e1;
            border-radius: 16px;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        /* ==========================================================================
           4. PRAVÝ SLOUPEC (CHYTRÉ UKOTVENÍ PŘIHLÁŠENÍ)
           ========================================================================== */
        .right-column {
            position: sticky;
            top: 120px; /* Formulář zůstane ukotvený při scrollování */
        }

        .login-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 40px;
            box-shadow: var(--shadow-lg);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .login-card h2 {
            font-size: 26px;
            color: var(--primary-dark);
            margin-bottom: 10px;
        }

        /* ==========================================================================
           5. TLAČÍTKA A FORMULÁŘE
           ========================================================================== */
        .btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            padding: 14px 28px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-full { width: 100%; }

        .btn-outline {
            background: transparent;
            color: var(--primary-dark);
            border: 2px solid var(--border-color);
        }
        .btn-outline:hover { background: #f8fafc; border-color: var(--primary-dark); }

        .btn-green {
            background: var(--primary-green);
            color: white;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }
        .btn-green:hover { background: var(--primary-green-hover); transform: translateY(-2px); box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3); }

        .btn-dark {
            background: var(--primary-dark);
            color: white;
            box-shadow: 0 4px 12px rgba(15, 37, 55, 0.2);
        }
        .btn-dark:hover { background: #1e3a8a; }

        .form-group { margin-bottom: 24px; }
        .form-group label {
            display: block; margin-bottom: 8px; font-size: 14px; font-weight: 700; color: var(--primary-dark);
        }
        .form-group input {
            width: 100%; padding: 16px; border: 1.5px solid var(--border-color); border-radius: 12px;
            outline: none; font-size: 16px; transition: all 0.2s; background: #f8fafc;
        }
        .form-group input:focus {
            border-color: var(--primary-green); box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1); background: #fff;
        }

        .divider {
            display: flex; align-items: center; text-align: center; margin: 36px 0; color: var(--text-light); font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
        }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid var(--border-color); }
        .divider::before { margin-right: 15px; } .divider::after { margin-left: 15px; }

    </style>
</head>
<body>

    <!-- ZVĚTŠENÁ SYMETRICKÁ HLAVIČKA -->
    <header>
        <div class="header-content">
            <a href="#" class="logo-container">
                <div class="logo-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                cistaslozka<span>.cz</span>
            </a>
            
            <nav>
                <a href="#tarify">Ceník a tarify</a>
                <a href="#funkce">Funkce systému</a>
                <a href="#sablony">Vzory dokumentů</a>
            </nav>

            <div class="header-right">
                <a href="#registrace" class="btn btn-outline" style="padding: 10px 20px; font-size: 14px;">Založit účet</a>
            </div>
        </div>
    </header>

    <!-- HLAVNÍ OBSAH -->
    <div class="main-wrapper" id="tarify">
        
        <!-- LEVÝ SLOUPEC: ROZEPSANÉ TARIFY -->
        <div class="left-column">
            
            <div>
                <h1 class="section-heading">Vyberte si svůj tarif</h1>
                <p class="section-subheading">Ať už jste na volné noze nebo řídíte firmu, máme pro vás čisté řešení.</p>
            </div>

            <!-- TARIF BASIC -->
            <div class="tariff-card">
                <div class="tariff-header">
                    <h3 class="tariff-title">Tarif Basic</h3>
                    <span class="badge-free">7 dní zkušební doba zdarma</span>
                </div>
                <div class="tariff-price">199 Kč <span>/ měsíc</span></div>
                
                <ul class="feature-list">
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Fakturace a platby:</strong> Faktury (plátce/neplátce), zálohovky, QR platby a upomínky.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Správa a archiv:</strong> Přehled všech vydaných faktur s možností úprav a označení úhrad.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Obchodní smlouvy:</strong> Smlouva o dílo a Smlouva o poskytování služeb.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Ochrana know-how:</strong> Licenční smlouva a Dohoda o mlčenlivosti (NDA).</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Provozní doklady:</strong> Předávací protokoly, cestovní příkazy a automatický Adresář z ARES.</span>
                    </li>
                </ul>
                <a href="#" class="btn btn-outline btn-full">Spustit tarif Basic</a>
            </div>

            <!-- TARIF PRO -->
            <div class="tariff-card tariff-pro">
                <div class="tariff-header">
                    <h3 class="tariff-title" style="color: var(--primary-green);">Tarif PRO</h3>
                    <span class="badge-free" style="background: var(--primary-dark); color: white;">Firemní a HR agenda</span>
                </div>
                <div class="tariff-price">349 Kč <span>/ měsíc</span></div>
                
                <ul class="feature-list">
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Vše z tarifu Basic</strong>, bez jakéhokoliv omezení počtu dokumentů.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>HR a Zaměstnanci:</strong> Pracovní smlouvy (HPP, DPP, DPČ), mzdové výměry a výpovědi.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Firemní procesy:</strong> Svěření notebooku/auta, BOZP školení a souhlasy s GDPR.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Účetnictví a B2B:</strong> Pokladní doklady, dobropisy, rámcové smlouvy a plné moci.</span>
                    </li>
                    <li>
                        <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span><strong>Týmový přístup:</strong> Možnost sdílení přístupu pro vaši asistentku nebo účetní.</span>
                    </li>
                </ul>
                <a href="#" class="btn btn-green btn-full">Přejít na tarif PRO</a>
            </div>

            <!-- PROMO KÓD -->
            <div class="promo-card">
                <div>
                    <h4 style="font-size: 16px; color: var(--primary-dark); margin-bottom: 4px;">Máte slevový kód?</h4>
                    <p style="font-size: 14px; color: var(--text-light);">Zadejte jej před dokončením platby.</p>
                </div>
                <div style="display: flex; gap: 8px;">
                    <input type="text" placeholder="Zadejte kód..." style="width: 160px; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; outline: none;">
                    <button class="btn btn-dark" style="padding: 12px 20px;">Uplatnit</button>
                </div>
            </div>

        </div>

        <!-- PRAVÝ SLOUPEC: PŘIHLÁŠENÍ (CHYTRÉ UKOTVENÍ) -->
        <div class="right-column">
            <div class="login-card">
                <h2>Vítejte zpět</h2>
                <p style="color: var(--text-light); margin-bottom: 32px; font-size: 15px;">Přihlaste se do své čisté složky.</p>
                
                <form>
                    <div class="form-group">
                        <label>E-mailová adresa</label>
                        <input type="email" placeholder="jmeno@firma.cz" required>
                    </div>
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between;">
                            <label>Heslo</label>
                            <a href="#" style="font-size: 14px; color: var(--primary-green); text-decoration: none; font-weight: 600;">Zapomenuté heslo?</a>
                        </div>
                        <input type="password" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-dark btn-full">Přihlásit se do systému</button>
                </form>

                <div class="divider">Nemáte ještě účet?</div>

                <a href="#registrace-stranka" class="btn btn-outline btn-full" style="color: var(--primary-green); border-color: rgba(16, 185, 129, 0.4);">
                    Vyzkoušet na 7 dní zdarma
                </a>
            </div>
        </div>

    </div>

</body>
</html>
