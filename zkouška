<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Osobní Finance</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 20px 0;
        }
        .container {
            max-width: 800px;
            margin: 40px auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        h1, h2, h3 {
            margin-top: 0;
        }
        .balance {
            font-size: 2.5em;
            color: #27ae60;
            text-align: center;
            margin: 20px 0;
            font-weight: bold;
        }
        .transactions {
            list-style: none;
            padding: 0;
        }
        .transactions li {
            background: #ecf0f1;
            margin-bottom: 10px;
            padding: 15px;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            font-size: 1.1em;
        }
        .income {
            color: #27ae60;
            font-weight: bold;
        }
        .expense {
            color: #c0392b;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <header>
        <h1>Moje Osobní Finance</h1>
    </header>

    <div class="container">
        <h2 style="text-align: center;">Aktuální zůstatek</h2>
        <div class="balance">45 200 Kč</div>

        <h3>Poslední transakce</h3>
        <ul class="transactions">
            <li>
                <span>Výplata - Zaměstnání</span>
                <span class="income">+ 50 000 Kč</span>
            </li>
            <li>
                <span>Nájemné</span>
                <span class="expense">- 15 000 Kč</span>
            </li>
            <li>
                <span>Nákup potravin - Supermarket</span>
                <span class="expense">- 2 500 Kč</span>
            </li>
            <li>
                <span>Předplatné - Netflix</span>
                <span class="expense">- 300 Kč</span>
            </li>
        </ul>
    </div>

</body>
</html>
